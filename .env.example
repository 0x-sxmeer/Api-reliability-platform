# Gateway environment configuration — copy to .env and fill in real values.
# NEVER commit the populated .env file (it is covered by .gitignore via *.env*
# patterns below / add ".env" if you use one).

# --- Ledger ---
# Path to the SQLite ledger DB (default: gateway.db). Point at a mounted
# volume or switch to Postgres when scaling out.
GATEWAY_DB_PATH=gateway.db

# --- Provider credentials (set REAL keys at deploy time) ---
# Local dev/tests fall back to "mock" so the server still boots without them,
# but any environment that should reach live vendors MUST set these.
OPENAI_API_KEY=sk-your-real-key-here
ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# Gemini / REST adapters are registered per-deployment as needed; their keys
# follow the same convention (e.g. GEMINI_API_KEY) once wired into lifespan().

# --- Run the server ---
# uvicorn gateway.server:app --host 0.0.0.0 --port 8000
# (with python-dotenv or your platform's secret store injecting the above)
